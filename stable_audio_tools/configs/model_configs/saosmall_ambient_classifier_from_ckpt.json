{
    "model_type": "dit_classifier",
    "sample_rate": 44100,
    "model": {
        "classifier": {
            "num_classes": 2,
            "pool": "mean",
            "depth_fraction": 0.5,
            "checkpoint_path": "/path/to/sao_small.ckpt",
            "diffusion_objective": "rectified_flow"
        }
    },
    "training": {
        "pre_encoded": true,
        "label_key": "label",
        "optimizer_configs": {
            "classifier": {
                "optimizer": {
                    "type": "AdamW",
                    "config": {
                        "lr": 1e-4,
                        "betas": [0.9, 0.95],
                        "eps": 1e-8,
                        "weight_decay": 0.01
                    }
                },
                "scheduler": {
                    "type": "InverseLR",
                    "config": {
                        "inv_gamma": 1000000,
                        "power": 0.5,
                        "warmup": 0.99
                    }
                }
            }
        }
    }
}
